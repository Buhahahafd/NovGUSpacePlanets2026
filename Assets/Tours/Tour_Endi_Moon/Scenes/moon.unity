  quizUI: {fileID: 1149834536}
  questions:
  - text: "\u041A\u0430\u043A\u043E\u0439 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u043E\u0431\u044A\u0435\u043A\u0442 \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043A\u0440\u043E\u043C\u0435
      \u0417\u0435\u043C\u043B\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043F\u043E\u0431\u044B\u0432\u0430\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A?"
    options:
    - "\u041C\u0430\u0440\u0441"
    - "\u0412\u0435\u043D\u0435\u0440\u0430"
    - "\u041B\u0443\u043D\u0430"
    - "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0438\u0433\u0434\u0435
      \u043D\u0435 \u0431\u044B\u043B, \u043A\u0440\u043E\u043C\u0435 \u0417\u0435\u043C\u043B\u0438"
    correctIndex: 2
  - text: "\u0412 \u043A\u0430\u043A\u043E\u043C \u0433\u043E\u0434\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0431\u044B\u0432\u0430\u043B
      \u043D\u0430 \u041B\u0443\u043D\u0435?"
    options:
    - 1969
    - 2015
    - 2024
    - 1986
    correctIndex: 0
  - text: "\u041B\u0443\u043D\u0430 \u2014 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0438\u043B\u0438 \u043D\u0435\u0442?"
    options:
    - "\u0414\u0430"
    - "\u041D\u0435\u0442"
    - "\u041B\u0443\u043D\u0430 \u2014 \u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0417\u0435\u043C\u043B\u0438"
    correctIndex: 2
  - text: "\u041A\u0430\u043A\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435
      \u043E\u0442 \u0417\u0435\u043C\u043B\u0438 \u0434\u043E \u041B\u0443\u043D\u044B?"
    options:
    - "\u041E\u043A\u043E\u043B\u043E 384 \u0442\u044B\u0441. \u043A\u043C"
    - "\u041E\u043A\u043E\u043B\u043E 100 \u0442\u044B\u0441. \u043A\u043C"
